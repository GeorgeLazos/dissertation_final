# Keys MIDAS needs. Copy to .env and fill in; .env is git-ignored.
# yfinance needs no key -- it reads public endpoints.

# Prices, fundamentals and corporate actions.
# sharadar.com subscription.
SHARADAR_KEY=

# Macro series with full ALFRED vintage history.
# Free: https://fredaccount.stlouisfed.org/apikeys
FRED_KEY=

# SEC EDGAR identifies callers by User-Agent and returns 403 without one.
# Format: Full Name email@example.com
SEC_USER_AGENT=

